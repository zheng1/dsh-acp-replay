{
  "name": "dsh-acp-replay",
  "version": "0.1.5-rc.1",
  "description": "Community ACP bridge for DeepSeek Harness that supports session/load by replaying a persisted session's transcript",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@deepseek-ai/dsh-brand": "0.1.5-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-attachment": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-mcp-client": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-session-persistence": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-token-meter": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-user-approval": "^0.1.5-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.1",
    "@deepseek-ai/dsh-attachment": "0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.1",
    "@deepseek-ai/dsh-mcp-client": "0.1.5-rc.1",
    "@deepseek-ai/dsh-session": "0.1.5-rc.1",
    "@deepseek-ai/dsh-session-persistence": "0.1.5-rc.1",
    "@deepseek-ai/dsh-token-meter": "0.1.5-rc.1",
    "@deepseek-ai/dsh-user-approval": "0.1.5-rc.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "acp",
    "agent-client-protocol",
    "session-load"
  ],
  "homepage": "https://github.com/zheng1/dsh-acp-replay#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zheng1/dsh-acp-replay.git"
  },
  "bugs": {
    "url": "https://github.com/zheng1/dsh-acp-replay/issues"
  },
  "engines": {
    "node": ">=22"
  }
}